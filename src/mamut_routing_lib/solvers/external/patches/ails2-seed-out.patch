diff --git a/src/Auxiliary/SharedRandom.java b/src/Auxiliary/SharedRandom.java
new file mode 100644
index 0000000..ac108df
--- /dev/null
+++ b/src/Auxiliary/SharedRandom.java
@@ -0,0 +1,16 @@
+package Auxiliary;
+
+import java.util.Random;
+
+/** Campaign patch: one process-wide RNG so every stochastic component shares the `-seed`. */
+public final class SharedRandom {
+    private static Random instance = new Random();
+
+    public static void seed(long seed) {
+        instance = new Random(seed);
+    }
+
+    public static Random get() {
+        return instance;
+    }
+}
