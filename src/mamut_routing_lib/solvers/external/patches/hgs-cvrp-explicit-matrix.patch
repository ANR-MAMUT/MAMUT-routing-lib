+			if (content == "DIMENSION") { inputFile >> content2 >> nbClients; dimension = nbClients; nbClients--; } // Need to substract the depot from the number of nodes
 			else if (content == "EDGE_WEIGHT_TYPE")	inputFile >> content2 >> content3;
+			else if (content == "EDGE_WEIGHT_FORMAT")
+			{
+				// MAMUT-routing patch: only a full matrix (rows i, columns j, so asymmetric costs are kept)
+				inputFile >> content2 >> content3;
+				if (content3 != "FULL_MATRIX") throw std::string("Only EDGE_WEIGHT_FORMAT FULL_MATRIX is supported, not " + content3);
+			}
+			else if (content == "EDGE_WEIGHT_SECTION")
+			{
+				// MAMUT-routing patch: dist_mtx[i][j] is the cost of travelling from node i+1 to node j+1
+				if (dimension <= 0) throw std::string("EDGE_WEIGHT_SECTION must come after DIMENSION");
+				dist_mtx = std::vector < std::vector< double > >(dimension, std::vector <double>(dimension));
+				for (int i = 0; i < dimension; i++)
+					for (int j = 0; j < dimension; j++)
+						if (!(inputFile >> dist_mtx[i][j])) throw std::string("Incomplete EDGE_WEIGHT_SECTION");
+				isExplicitMatrix = true;
+			}
